                        <Grid Grid.Row="1" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtAiCommand" Grid.Column="0" Text="Render HyperFrames promo video" Style="{StaticResource StudioTextBox}"/>
                            <Button x:Name="BtnRunAiCommand" Grid.Column="2" Content="Dispatch" Click="BtnRunAiCommand_Click"
                                    Style="{StaticResource StudioSecondaryButton}" Padding="8,4" FontSize="10.5"/>
                        </Grid>

                        <TextBox x:Name="TxtLogs" Grid.Row="2" IsReadOnly="True"
                                 Background="#090B0E" Foreground="#A7F3D0" BorderBrush="#1F2430" BorderThickness="1"
                                 FontFamily="Consolas" FontSize="9.5" Padding="6" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- BOTTOM WORKSTATION STATUS BAR -->
        <Border Grid.Row="2" Background="#0E1015" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid>
                <TextBlock Text="Clean Architecture: Domain -> Application -> Infrastructure -> Presentation  |  VoiceStudio + Podcast AI + Interactive NLE Timeline v4.0"
                           FontSize="9.5" Foreground="#6B7280" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtStatusRight" Text="No active project selected"
                           FontSize="9.5" FontFamily="Consolas" Foreground="#9CA3AF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
