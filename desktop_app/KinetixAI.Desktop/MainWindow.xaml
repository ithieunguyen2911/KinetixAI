                                <TextBlock x:Name="TxtSpecAudio" Text="AUD: aac / 16000Hz" FontSize="9.5" FontFamily="Consolas" Foreground="#D1D5DB" Margin="0,1"/>
                                <TextBlock x:Name="TxtSpecDuration" Text="DUR: 6.00s" FontSize="9.5" FontFamily="Consolas" Foreground="#D1D5DB" Margin="0,1"/>
                                <TextBlock x:Name="TxtSpecSize" Text="SIZE: -- KB" FontSize="9.5" FontFamily="Consolas" Foreground="#D1D5DB" Margin="0,1"/>
                            </UniformGrid>
                        </Border>
