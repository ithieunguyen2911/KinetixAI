<Window x:Class="KinetixAI.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kinetix Studio v4.0 — AI Storyboard, Podcast, VoiceStudio &amp; Multi-Track NLE Workstation"
        Height="960" Width="1640"
        MinHeight="800" MinWidth="1360"
        WindowStartupLocation="CenterScreen"
        Background="#0B0D10"
        Foreground="#F3F4F6"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="BgCanvas" Color="#0B0D10"/>
        <SolidColorBrush x:Key="BgPanel" Color="#12151B"/>
        <SolidColorBrush x:Key="BgSurface" Color="#191D26"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#252A36"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="AccentPrimary" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentHover" Color="#1D4ED8"/>

        <Style x:Key="StudioTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0E1015"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="CaretBrush" Value="#60A5FA"/>
            <Setter Property="BorderBrush" Value="#282E3B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <Style x:Key="StudioComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#0E1015"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#282E3B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="StudioPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#1F2430"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2A3040"/>
                                <Setter Property="Foreground" Value="#6B7280"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StudioSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1C202B"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#2D3446"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252B3B"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3E475E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#151821"/>
                                <Setter Property="Foreground" Value="#4B5563"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StudioTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBd" Background="#12151C" BorderBrush="#222734" BorderThickness="1,1,1,0"
                                CornerRadius="4,4,0,0" Padding="9,5" Margin="0,0,3,0">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBd" Property="Background" Value="#1B202C"/>
                                <Setter Property="Foreground" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBd" Property="Background" Value="#172554"/>
                                <Setter TargetName="TabBd" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#161A23"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="BorderBrush" Value="#232836"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- TOP NLE WORKSTATION BAR -->
        <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Identity -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="8" Height="18" Background="{StaticResource AccentPrimary}" CornerRadius="2" Margin="0,0,8,0"/>
                    <TextBlock Text="KINETIX STUDIO" FontSize="13" FontWeight="Bold" Foreground="#F9FAFB" VerticalAlignment="Center"/>
                    <Border Background="#181C26" BorderBrush="#282E3D" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="7,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v4.0 NLE" FontSize="10" Foreground="#60A5FA" FontFamily="Consolas" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Format, Speed, Transition & Motion FX Quick Deck -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="ASPECT:" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Button x:Name="BtnAspect16x9" Content="16:9" Click="BtnAspect16x9_Click" Style="{StaticResource StudioSecondaryButton}" Padding="6,2" FontSize="10" Margin="0,0,3,0"/>
                    <Button x:Name="BtnAspect9x16" Content="9:16" Click="BtnAspect9x16_Click" Style="{StaticResource StudioSecondaryButton}" Padding="6,2" FontSize="10" Margin="0,0,3,0"/>
                    <Button x:Name="BtnAspect1x1" Content="1:1" Click="BtnAspect1x1_Click" Style="{StaticResource StudioSecondaryButton}" Padding="6,2" FontSize="10" Margin="0,0,9,0"/>

                    <TextBlock Text="SPEED:" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="CmbSpeedFactor" Width="62" SelectedIndex="2" Style="{StaticResource StudioComboBox}" Padding="4,2" FontSize="10" Margin="0,0,4,0">
                        <ComboBoxItem Content="0.50x" Tag="0.5"/>
                        <ComboBoxItem Content="0.75x" Tag="0.75"/>
                        <ComboBoxItem Content="1.00x" Tag="1.0"/>
                        <ComboBoxItem Content="1.25x" Tag="1.25"/>
                        <ComboBoxItem Content="1.50x" Tag="1.5"/>
                        <ComboBoxItem Content="2.00x" Tag="2.0"/>
                    </ComboBox>
                    <Button x:Name="BtnApplySpeed" Content="Speed" Click="BtnApplySpeed_Click" Style="{StaticResource StudioSecondaryButton}" Padding="6,2" FontSize="10" Margin="0,0,9,0"/>

                    <TextBlock Text="TRANS:" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="CmbTransitionPreset" Width="96" SelectedIndex="1" Style="{StaticResource StudioComboBox}" Padding="4,2" FontSize="10" Margin="0,0,5,0">
                        <ComboBoxItem Content="none" Tag="none"/>
                        <ComboBoxItem Content="fade_black" Tag="fade_black"/>
                        <ComboBoxItem Content="cross_dissolve" Tag="cross_dissolve"/>
                        <ComboBoxItem Content="wipe_left" Tag="wipe_left"/>
                        <ComboBoxItem Content="slide_up" Tag="slide_up"/>
                        <ComboBoxItem Content="glitch_flash" Tag="glitch_flash"/>
                    </ComboBox>

                    <TextBlock Text="ANIM:" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="CmbAnimationPreset" Width="112" SelectedIndex="0" Style="{StaticResource StudioComboBox}" Padding="4,2" FontSize="10" Margin="0,0,4,0">
                        <ComboBoxItem Content="spring_pop" Tag="spring_pop"/>
                        <ComboBoxItem Content="ken_burns_zoom" Tag="ken_burns_zoom"/>
                        <ComboBoxItem Content="typewriter_reveal" Tag="typewriter_reveal"/>
                        <ComboBoxItem Content="neon_glow_pulse" Tag="neon_glow_pulse"/>
                        <ComboBoxItem Content="slide_up_bounce" Tag="slide_up_bounce"/>
                        <ComboBoxItem Content="camera_shake_impact" Tag="camera_shake_impact"/>
                    </ComboBox>
                    <Button x:Name="BtnApplyFxMotion" Content="Apply FX" Click="BtnApplyFxMotion_Click" Style="{StaticResource StudioSecondaryButton}" Padding="7,2" FontSize="10"/>
                </StackPanel>

                <!-- Right System Telemetry, User Guide & MCP Status -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnOpenUserGuide" Content="Hướng Dẫn (User Guide)" Click="BtnOpenUserGuide_Click"
                            Style="{StaticResource StudioSecondaryButton}" Padding="8,3" FontSize="10.5" Margin="0,0,6,0"/>
                    <Border Background="#141821" BorderBrush="#252B3B" BorderThickness="1" CornerRadius="4" Padding="7,3" Margin="0,0,5,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#3B82F6" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtMcpStatus" Text="MCP: 27 Tools" FontSize="10" Foreground="#D1D5DB"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#141821" BorderBrush="#252B3B" BorderThickness="1" CornerRadius="4" Padding="7,3" Margin="0,0,5,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotBackend" Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtBackendStatus" Text="Core API: Online" FontSize="10" Foreground="#D1D5DB"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnRefreshProjects" Content="Sync" Click="BtnRefreshProjects_Click"
                            Style="{StaticResource StudioSecondaryButton}" Padding="8,3" FontSize="10"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN 3-COLUMN NLE WORKSPACE -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="305"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="335"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT DOCK: PROJECT INGEST, MOTION TEMPLATE & WORKSPACE BIN -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="11">
                    <StackPanel>
                        <TextBlock Text="MEDIA INGEST &amp; MOTION ENGINE" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,7"/>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="108"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Project ID" Foreground="#9CA3AF" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtProjectId" Text="studio_master_v4" Style="{StaticResource StudioTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Render Engine" Foreground="#9CA3AF" FontSize="10" Margin="0,0,0,2"/>
                                <ComboBox x:Name="CmbEngineType" SelectedIndex="0" Style="{StaticResource StudioComboBox}">
                                    <ComboBoxItem Content="remotion" Tag="remotion"/>
                                    <ComboBoxItem Content="hyperframes" Tag="hyperframes"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Motion Graphics Template" Foreground="#9CA3AF" FontSize="10" Margin="0,0,0,2"/>
                        <ComboBox x:Name="CmbTemplateId" SelectedIndex="0" Style="{StaticResource StudioComboBox}" Margin="0,0,0,5">
                            <ComboBoxItem Content="CaptionTemplate" Tag="CaptionTemplate"/>
                            <ComboBoxItem Content="KineticTitleCard" Tag="KineticTitleCard"/>
                            <ComboBoxItem Content="SocialPopCaptions" Tag="SocialPopCaptions"/>
                            <ComboBoxItem Content="TechCalloutHUD" Tag="TechCalloutHUD"/>
                        </ComboBox>

                        <TextBlock Text="Source Input (URL, File, or demo://sample)" Foreground="#9CA3AF" FontSize="10" Margin="0,0,0,2"/>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtSourceUrl" Text="demo://sample" Style="{StaticResource StudioTextBox}"/>
                            <Button x:Name="BtnInspectSource" Grid.Column="2" Content="Inspect" Click="BtnInspectSource_Click" Style="{StaticResource StudioSecondaryButton}" Padding="6,4" FontSize="10"/>
                            <Button x:Name="BtnBrowseFile" Grid.Column="4" Content="Browse" Click="BtnBrowseFile_Click" Style="{StaticResource StudioSecondaryButton}" Padding="6,4" FontSize="10"/>
                        </Grid>

                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Script / Captions (tự tách câu theo dấu chấm hoặc |)" Foreground="#9CA3AF" FontSize="10" VerticalAlignment="Center"/>
                            <Button x:Name="BtnClearScript" Grid.Column="1" Content="Auto-Whisper" Click="BtnClearScript_Click" Style="{StaticResource StudioSecondaryButton}" Padding="5,1" FontSize="9.5"/>
                        </Grid>
                        <TextBox x:Name="TxtScriptText"
                                 Text="Xin chào, tôi là AI của thế kỷ 28. Và tôi sẽ thay đổi cuộc sống của bạn."
                                 Style="{StaticResource StudioTextBox}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="46" VerticalScrollBarVisibility="Auto" Margin="0,0,0,7"/>

                        <Button x:Name="BtnRunPipeline" Content="Execute 5-Step Production Pipeline" Click="BtnRunPipeline_Click"
                                Style="{StaticResource StudioPrimaryButton}" Margin="0,0,0,5"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnRerenderSubtitles" Grid.Column="0" Content="Re-Render Overlay" Click="BtnRerenderSubtitles_Click" Style="{StaticResource StudioSecondaryButton}" Padding="6,4" FontSize="10.5"/>
                            <Button x:Name="BtnOpenFolder" Grid.Column="2" Content="Reveal Folder" Click="BtnOpenFolder_Click" Style="{StaticResource StudioSecondaryButton}" Padding="6,4" FontSize="10.5"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Media Bin / Workspace Projects with Clone & Delete -->
                <Border Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="11,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="PROJECTS BIN" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtProjectCount" Text=" (0)" FontSize="10" Foreground="#6B7280" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnCloneProject" Content="Clone" Click="BtnCloneProject_Click" Style="{StaticResource StudioSecondaryButton}" Padding="6,2" FontSize="10" Margin="0,0,4,0"/>
                                <Button x:Name="BtnDeleteProject" Content="Delete" Click="BtnDeleteProject_Click" Style="{StaticResource StudioSecondaryButton}" Padding="6,2" FontSize="10"/>
                            </StackPanel>
                        </Grid>
                        <ListBox x:Name="LstProjects" Grid.Row="1"
                                 Background="#0D0F13" BorderBrush="#222631" BorderThickness="1"
                                 Foreground="#F3F4F6" SelectionChanged="LstProjects_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="7,5"/>
                                    <Setter Property="Margin" Value="2"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBd" Background="#12151C" BorderBrush="#1F2430" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="2">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBd" Property="Background" Value="#181C26"/>
                                                        <Setter TargetName="ItemBd" Property="BorderBrush" Value="#2E3648"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBd" Property="Background" Value="#172136"/>
                                                        <Setter TargetName="ItemBd" Property="BorderBrush" Value="#3B82F6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding ProjectId}" FontWeight="SemiBold" FontSize="11" Foreground="#F3F4F6" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding CurrentStep}" FontSize="9.5" Foreground="#9CA3AF" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#1E2433" BorderBrush="#313A50" BorderThickness="1" CornerRadius="3" Padding="5,1" VerticalAlignment="Center" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding EngineUpper}" FontSize="8.5" FontFamily="Consolas" FontWeight="Bold" Foreground="#93C5FD"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- CENTER DOCK: PROGRAM MONITOR + INTERACTIVE 5-TRACK TIMELINE (CRUD) + 6-TAB STUDIO -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="230"/>
                    <RowDefinition Height="7"/>
                    <RowDefinition Height="228"/>
                    <RowDefinition Height="7"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. PROGRAM VIDEO MONITOR & TRANSPORT DECK -->
                <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="PROGRAM MONITOR" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtOutputPath" Text="" FontSize="9.5" Foreground="#6B7280" FontFamily="Consolas" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtTimecode" Text="00.00s / 06.00s" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Right"/>
                        </Grid>

                        <Border Grid.Row="1" Background="#050608" BorderBrush="#1F2430" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                            <Grid>
                                <TextBlock x:Name="TxtVideoPlaceholder"
                                           Text="No active video loaded in monitor. Select a project or execute pipeline."
                                           Foreground="#6B7280" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <MediaElement x:Name="VideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"
                                              MediaOpened="VideoPlayer_MediaOpened" MediaEnded="VideoPlayer_MediaEnded"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button x:Name="BtnPlayPause" Content="Play" Width="46" Click="BtnPlayPause_Click" Style="{StaticResource StudioSecondaryButton}" Padding="4,2" Margin="0,0,3,0"/>
                                <Button x:Name="BtnStopVideo" Content="Stop" Width="42" Click="BtnStopVideo_Click" Style="{StaticResource StudioSecondaryButton}" Padding="4,2" Margin="0,0,3,0"/>
                                <Button x:Name="BtnStepBack" Content="-1f" Width="32" Click="BtnStepBack_Click" Style="{StaticResource StudioSecondaryButton}" Padding="2,2" Margin="0,0,3,0"/>
                                <Button x:Name="BtnStepForward" Content="+1f" Width="32" Click="BtnStepForward_Click" Style="{StaticResource StudioSecondaryButton}" Padding="2,2" Margin="0,0,5,0"/>
                                <Button x:Name="BtnMarkIn" Content="Set In [" Click="BtnMarkIn_Click" Style="{StaticResource StudioSecondaryButton}" Padding="6,2" Margin="0,0,3,0"/>
                                <Button x:Name="BtnMarkOut" Content="Set Out ]" Click="BtnMarkOut_Click" Style="{StaticResource StudioSecondaryButton}" Padding="6,2" Margin="0,0,5,0"/>
                            </StackPanel>

                            <Slider x:Name="SliderScrub" Grid.Column="1" Minimum="0" Maximum="6" Value="0" VerticalAlignment="Center" Margin="4,0,8,0"
                                    PreviewMouseLeftButtonUp="SliderScrub_PreviewMouseLeftButtonUp"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button x:Name="BtnSnapshot" Content="Snapshot PNG" Click="BtnSnapshot_Click" Style="{StaticResource StudioSecondaryButton}" Padding="7,2" Margin="0,0,4,0"/>
                                <Button x:Name="BtnOpenVideo" Content="External Player" Click="BtnOpenVideo_Click" Style="{StaticResource StudioSecondaryButton}" Padding="7,2"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 2. INTERACTIVE 5-TRACK MULTI-LAYER NLE TIMELINE WITH INLINE ADD / EDIT / SPLIT / CLONE / DELETE -->
                <Border Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header + Summary -->
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="INTERACTIVE MULTI-TRACK NLE TIMELINE" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                <TextBlock Text="  •  Click khối clip bất kỳ để chọn &amp; Thêm / Sửa / Cắt Đôi / Nhân Bản / Xóa" FontSize="9.5" Foreground="#6B7280" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtTimelineSummary" Text="5 Tracks Active | Click Clip to Edit" FontSize="9.5" FontFamily="Consolas" Foreground="#9CA3AF" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- INLINE TIMELINE CLIP QUICK-EDITOR BAR -->
                        <Border Grid.Row="1" Background="#141822" BorderBrush="#232A3B" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="CmbClipTrack" Grid.Column="0" SelectedIndex="2" Style="{StaticResource StudioComboBox}" Padding="4,2" FontSize="10">
                                    <ComboBoxItem Content="V2" Tag="V2"/>
                                    <ComboBoxItem Content="V1" Tag="V1"/>
                                    <ComboBoxItem Content="S1" Tag="S1"/>
                                    <ComboBoxItem Content="A1" Tag="A1"/>
                                    <ComboBoxItem Content="B1" Tag="B1"/>
                                </ComboBox>
                                <TextBox x:Name="TxtClipStart" Grid.Column="2" Text="0.00" Style="{StaticResource StudioTextBox}" Padding="4,2" FontSize="10.5" ToolTip="Clip Start (In sec)"/>
                                <TextBox x:Name="TxtClipEnd" Grid.Column="4" Text="2.00" Style="{StaticResource StudioTextBox}" Padding="4,2" FontSize="10.5" ToolTip="Clip End (Out sec)"/>
                                <TextBox x:Name="TxtClipLabel" Grid.Column="6" Text="Chọn khối clip trên timeline hoặc nhập nội dung mới..." Style="{StaticResource StudioTextBox}" Padding="6,2" FontSize="10.5"/>

                                <StackPanel Grid.Column="8" Orientation="Horizontal">
                                    <Button x:Name="BtnTimelineAddClip" Content="+ Thêm" Click="BtnTimelineAddClip_Click" Style="{StaticResource StudioSecondaryButton}" Padding="6,2" FontSize="10" Margin="0,0,3,0" ToolTip="Thêm clip mới vào Timeline"/>
                                    <Button x:Name="BtnTimelineSaveClip" Content="Sửa" Click="BtnTimelineSaveClip_Click" Style="{StaticResource StudioSecondaryButton}" Padding="6,2" FontSize="10" Margin="0,0,3,0" ToolTip="Lưu chỉnh sửa clip đang chọn"/>
                                    <Button x:Name="BtnTimelineSplitClip" Content="Cắt Đôi" Click="BtnTimelineSplitClip_Click" Style="{StaticResource StudioSecondaryButton}" Padding="6,2" FontSize="10" Margin="0,0,3,0" ToolTip="Cắt đôi clip tại vị trí Playhead đỏ"/>
                                    <Button x:Name="BtnTimelineCloneClip" Content="Nhân Bản" Click="BtnTimelineCloneClip_Click" Style="{StaticResource StudioSecondaryButton}" Padding="6,2" FontSize="10" Margin="0,0,3,0" ToolTip="Nhân bản clip đang chọn"/>
                                    <Button x:Name="BtnTimelineDeleteClip" Content="Xóa" Click="BtnTimelineDeleteClip_Click" Style="{StaticResource StudioSecondaryButton}" Padding="6,2" FontSize="10" Margin="0,0,4,0" ToolTip="Xóa clip đang chọn"/>
                                    <Button x:Name="BtnTimelineRenderVideo" Content="Áp Dụng Timeline" Click="BtnTimelineRenderVideo_Click" Style="{StaticResource StudioPrimaryButton}" Padding="7,2" FontSize="10" ToolTip="Render toàn bộ chỉnh sửa trên Timeline ra MP4"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- TIMECODE RULER -->
                        <Grid Grid.Row="2" Margin="82,0,0,2" Background="#0B0D13" MouseLeftButtonDown="TimelineCanvas_MouseLeftButtonDown" Cursor="Hand">
                            <UniformGrid Rows="1" Columns="6">
                                <TextBlock Text="00:00.0" FontSize="8.5" FontFamily="Consolas" Foreground="#6B7280" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <TextBlock x:Name="TxtRuler1" Text="00:01.2" FontSize="8.5" FontFamily="Consolas" Foreground="#6B7280" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtRuler2" Text="00:02.4" FontSize="8.5" FontFamily="Consolas" Foreground="#6B7280" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtRuler3" Text="00:03.6" FontSize="8.5" FontFamily="Consolas" Foreground="#6B7280" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtRuler4" Text="00:04.8" FontSize="8.5" FontFamily="Consolas" Foreground="#6B7280" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtRuler5" Text="00:06.0" FontSize="8.5" FontFamily="Consolas" Foreground="#6B7280" VerticalAlignment="Center"/>
                            </UniformGrid>
                        </Grid>

                        <!-- 5 CLICKABLE TRACK LANES + RED PLAYHEAD -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="82"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <UniformGrid Grid.Column="0" Rows="5" Columns="1" Margin="0,0,4,0">
                                <Border Background="#141822" BorderBrush="#23293A" BorderThickness="1" CornerRadius="3" Margin="0,1" Padding="5,0">
                                    <TextBlock Text="V2 OVERLAY" FontSize="8.5" FontFamily="Consolas" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="#141822" BorderBrush="#23293A" BorderThickness="1" CornerRadius="3" Margin="0,1" Padding="5,0">
                                    <TextBlock Text="V1 VIDEO" FontSize="8.5" FontFamily="Consolas" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="#141822" BorderBrush="#23293A" BorderThickness="1" CornerRadius="3" Margin="0,1" Padding="5,0">
                                    <TextBlock Text="S1 CAPTIONS" FontSize="8.5" FontFamily="Consolas" FontWeight="Bold" Foreground="#FBBF24" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="#141822" BorderBrush="#23293A" BorderThickness="1" CornerRadius="3" Margin="0,1" Padding="5,0">
                                    <TextBlock Text="A1 AUDIO" FontSize="8.5" FontFamily="Consolas" FontWeight="Bold" Foreground="#A78BFA" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="#141822" BorderBrush="#23293A" BorderThickness="1" CornerRadius="3" Margin="0,1" Padding="5,0">
                                    <TextBlock Text="B1 BEATS/SFX" FontSize="8.5" FontFamily="Consolas" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                </Border>
                            </UniformGrid>

                            <Grid x:Name="TimelineTrackArea" Grid.Column="1" Background="#090B10" ClipToBounds="True"
                                  SizeChanged="TimelineTrackArea_SizeChanged"
                                  MouseLeftButtonDown="TimelineCanvas_MouseLeftButtonDown" Cursor="Hand">
                                <UniformGrid Rows="5" Columns="1">
                                    <!-- V2 OVERLAY TRACK -->
                                    <Border BorderBrush="#171B26" BorderThickness="0,0,0,1" Padding="0,1">
                                        <ItemsControl x:Name="IcTimelineV2">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Height="22"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding LeftPx}"/>
                                                    <Setter Property="Canvas.Top" Value="0"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding WidthPx}" Height="21" Background="{Binding BackgroundHex}" BorderBrush="{Binding BorderHex}" BorderThickness="{Binding BorderThicknessStr}" CornerRadius="3" Padding="5,0" Cursor="Hand"
                                                            MouseLeftButtonDown="TimelineClipBlock_MouseLeftButtonDown" ToolTip="{Binding Label}">
                                                        <Border.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Cắt đôi tại Playhead" Click="BtnTimelineSplitClip_Click"/>
                                                                <MenuItem Header="Nhân bản Clip" Click="BtnTimelineCloneClip_Click"/>
                                                                <MenuItem Header="Xóa Clip" Click="BtnTimelineDeleteClip_Click"/>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <TextBlock Text="{Binding Label}" FontSize="9" FontFamily="Consolas" Foreground="#BFDBFE" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                    <!-- V1 VIDEO TRACK -->
                                    <Border BorderBrush="#171B26" BorderThickness="0,0,0,1" Padding="0,1">
                                        <ItemsControl x:Name="IcTimelineV1">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Height="22"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding LeftPx}"/>
                                                    <Setter Property="Canvas.Top" Value="0"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding WidthPx}" Height="21" Background="{Binding BackgroundHex}" BorderBrush="{Binding BorderHex}" BorderThickness="{Binding BorderThicknessStr}" CornerRadius="3" Padding="5,0" Cursor="Hand"
                                                            MouseLeftButtonDown="TimelineClipBlock_MouseLeftButtonDown" ToolTip="{Binding Label}">
                                                        <Border.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Cắt đôi tại Playhead" Click="BtnTimelineSplitClip_Click"/>
                                                                <MenuItem Header="Nhân bản Clip" Click="BtnTimelineCloneClip_Click"/>
                                                                <MenuItem Header="Xóa Clip" Click="BtnTimelineDeleteClip_Click"/>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <TextBlock Text="{Binding Label}" FontSize="9" FontFamily="Consolas" Foreground="#A7F3D0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                    <!-- S1 SUBTITLES TRACK -->
                                    <Border BorderBrush="#171B26" BorderThickness="0,0,0,1" Padding="0,1">
                                        <ItemsControl x:Name="IcTimelineSubtitles">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Height="22"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding LeftPx}"/>
                                                    <Setter Property="Canvas.Top" Value="0"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding WidthPx}" Height="21" Background="{Binding BackgroundHex}" BorderBrush="{Binding BorderHex}" BorderThickness="{Binding BorderThicknessStr}" CornerRadius="3" Padding="5,0" Cursor="Hand"
                                                            MouseLeftButtonDown="TimelineClipBlock_MouseLeftButtonDown" ToolTip="{Binding Label}">
                                                        <Border.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Cắt đôi tại Playhead" Click="BtnTimelineSplitClip_Click"/>
                                                                <MenuItem Header="Nhân bản Cue" Click="BtnTimelineCloneClip_Click"/>
                                                                <MenuItem Header="Xóa Cue" Click="BtnTimelineDeleteClip_Click"/>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <TextBlock Text="{Binding Label}" FontSize="9" Foreground="#FEF3C7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                    <!-- A1 AUDIO TRACK -->
                                    <Border BorderBrush="#171B26" BorderThickness="0,0,0,1" Padding="0,1">
                                        <ItemsControl x:Name="IcTimelineA1">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Height="22"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding LeftPx}"/>
                                                    <Setter Property="Canvas.Top" Value="0"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding WidthPx}" Height="21" Background="{Binding BackgroundHex}" BorderBrush="{Binding BorderHex}" BorderThickness="{Binding BorderThicknessStr}" CornerRadius="3" Padding="5,0" Cursor="Hand"
                                                            MouseLeftButtonDown="TimelineClipBlock_MouseLeftButtonDown" ToolTip="{Binding Label}">
                                                        <TextBlock Text="{Binding Label}" FontSize="9" FontFamily="Consolas" Foreground="#DDD6FE" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                    <!-- B1 BEATS / SFX TRACK -->
                                    <Border Padding="0,1">
                                        <ItemsControl x:Name="IcTimelineBeats">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Height="22"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding LeftPx}"/>
                                                    <Setter Property="Canvas.Top" Value="1"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="9" Height="18" Background="{Binding BackgroundHex}" BorderBrush="{Binding BorderHex}" BorderThickness="{Binding BorderThicknessStr}" CornerRadius="2"
                                                            MouseLeftButtonDown="TimelineClipBlock_MouseLeftButtonDown" ToolTip="{Binding Label}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </UniformGrid>

                                <Canvas IsHitTestVisible="False">
                                    <Border x:Name="PlayheadLine" Canvas.Left="0" Canvas.Top="0" Width="2" Height="142" Background="#EF4444">
                                        <Border Width="10" Height="7" Background="#EF4444" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="-4,0,0,0"/>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 3. 6-TAB STUDIO WORKSTATION (SUBTITLES, CONTEXT/SCENES, CHARACTERS, AUDIO/BEAT, PODCAST & VOICESTUDIO, AUDIT LOGS) -->
                <Border Grid.Row="4" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,7">
                    <TabControl x:Name="MainStudioTabs" Background="#0D0F13" BorderBrush="#232836" BorderThickness="1" Padding="7">

                        <!-- TAB 1: SUBTITLES -->
                        <TabItem Header="PHỤ ĐỀ (SUBTITLES)" Style="{StaticResource StudioTabItem}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,5">
                                    <TextBlock Text="SUBTITLE CUES (WHISPER WORD-LEVEL TIMESTAMPS)" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="BtnAddSubtitleRow" Content="+ Thêm Cue" Click="BtnAddSubtitleRow_Click" Style="{StaticResource StudioSecondaryButton}" Padding="7,2" FontSize="10" Margin="0,0,4,0"/>
                                        <Button x:Name="BtnCloneSubtitleRow" Content="Nhân bản Cue" Click="BtnCloneSubtitleRow_Click" Style="{StaticResource StudioSecondaryButton}" Padding="7,2" FontSize="10" Margin="0,0,4,0"/>
                                        <Button x:Name="BtnSplitSubtitleCue" Content="Tách tại Playhead" Click="BtnSplitSubtitleCue_Click" Style="{StaticResource StudioSecondaryButton}" Padding="7,2" FontSize="10" Margin="0,0,4,0"/>
                                        <Button x:Name="BtnExportSubtitles" Content="Xuất SRT / VTT" Click="BtnExportSubtitles_Click" Style="{StaticResource StudioSecondaryButton}" Padding="7,2" FontSize="10" Margin="0,0,4,0"/>
                                        <Button x:Name="BtnRemoveSubtitleRow" Content="Xóa Cue" Click="BtnRemoveSubtitleRow_Click" Style="{StaticResource StudioSecondaryButton}" Padding="7,2" FontSize="10"/>
                                    </StackPanel>
                                </Grid>

                                <DataGrid x:Name="GridSubtitles" Grid.Row="1"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          Background="#0D0F13" Foreground="#F3F4F6"
                                          BorderBrush="#222631" BorderThickness="1"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1B1F2A"
                                          RowBackground="#111319" AlternatingRowBackground="#151821"
                                          HeadersVisibility="Column" RowHeaderWidth="0" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="IN (SEC)" Binding="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}" Width="72"/>
                                        <DataGridTextColumn Header="OUT (SEC)" Binding="{Binding EndTime, UpdateSourceTrigger=PropertyChanged}" Width="72"/>
                                        <DataGridTextColumn Header="DUR" Binding="{Binding DurationDisplay}" Width="58" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="WORDS" Binding="{Binding WordCount}" Width="54" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="CAPTION DIALOGUE TEXT (EDITABLE)" Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- TAB 2: CONTEXT & SCENES -->
                        <TabItem Header="BỐI CẢNH &amp; PHÂN CẢNH" Style="{StaticResource StudioTabItem}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#12161F" BorderBrush="#242B3A" BorderThickness="1" CornerRadius="4" Padding="7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="5"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="5"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="5"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Bối cảnh thế giới (World Setting)" FontSize="9" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                            <TextBox x:Name="TxtWorldSetting" Style="{StaticResource StudioTextBox}" Padding="5,3" FontSize="10"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Phong cách hình ảnh (Visual Style)" FontSize="9" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                            <TextBox x:Name="TxtVisualStyle" Style="{StaticResource StudioTextBox}" Padding="5,3" FontSize="10"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Ánh sáng &amp; Ống kính (Light / Lens)" FontSize="9" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                            <TextBox x:Name="TxtLightingMood" Style="{StaticResource StudioTextBox}" Padding="5,3" FontSize="10"/>
                                        </StackPanel>
                                        <Button x:Name="BtnSaveContext" Grid.Column="6" Content="Lưu Bối Cảnh" Click="BtnSaveContext_Click"
                                                Style="{StaticResource StudioSecondaryButton}" VerticalAlignment="Bottom" Padding="9,4" FontSize="10"/>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="2" Margin="0,0,0,4">
                                    <TextBlock Text="STORYBOARD SCENES (THÊM / SỬA / NHÂN BẢN / XÓA PHÂN CẢNH)" FontSize="9.5" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="BtnAddScene" Content="+ Thêm Cảnh" Click="BtnAddScene_Click" Style="{StaticResource StudioSecondaryButton}" Padding="7,2" FontSize="10" Margin="0,0,4,0"/>
                                        <Button x:Name="BtnCloneScene" Content="Nhân bản" Click="BtnCloneScene_Click" Style="{StaticResource StudioSecondaryButton}" Padding="7,2" FontSize="10" Margin="0,0,4,0"/>
                                        <Button x:Name="BtnDeleteScene" Content="Xóa Cảnh" Click="BtnDeleteScene_Click" Style="{StaticResource StudioSecondaryButton}" Padding="7,2" FontSize="10" Margin="0,0,4,0"/>
                                        <Button x:Name="BtnSaveScenes" Content="Lưu Phân Cảnh" Click="BtnSaveScenes_Click" Style="{StaticResource StudioPrimaryButton}" Padding="8,2" FontSize="10"/>
                                    </StackPanel>
                                </Grid>

                                <DataGrid x:Name="GridScenes" Grid.Row="3"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          Background="#0D0F13" Foreground="#F3F4F6"
                                          BorderBrush="#222631" BorderThickness="1"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1B1F2A"
                                          RowBackground="#111319" AlternatingRowBackground="#151821"
                                          HeadersVisibility="Column" RowHeaderWidth="0" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding SceneId}" Width="72"/>
                                        <DataGridTextColumn Header="TÊN CẢNH" Binding="{Binding Title}" Width="105"/>
                                        <DataGridTextColumn Header="NHÂN VẬT" Binding="{Binding CharacterId}" Width="88"/>
                                        <DataGridTextColumn Header="START" Binding="{Binding StartTime}" Width="52"/>
                                        <DataGridTextColumn Header="DUR" Binding="{Binding DurationSec}" Width="48"/>
                                        <DataGridTextColumn Header="CHUYỂN CẢNH" Binding="{Binding TransitionIn}" Width="92"/>
                                        <DataGridTextColumn Header="SFX" Binding="{Binding SfxId}" Width="98"/>
                                        <DataGridTextColumn Header="LỜI THOẠI / BỐI CẢNH CHI TIẾT" Binding="{Binding NarrationText}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- TAB 3: CONSISTENT CHARACTERS -->
                        <TabItem Header="NHÂN VẬT ĐỒNG NHẤT" Style="{StaticResource StudioTabItem}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,5">
                                    <TextBlock Text="CONSISTENT CHARACTER PROFILES (ĐỒNG BỘ GIỌNG ĐỌC, MÀU SẮC &amp; NHẬN DIỆN HUD)" FontSize="9.5" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="BtnAddCharacter" Content="+ Thêm Nhân Vật" Click="BtnAddCharacter_Click" Style="{StaticResource StudioSecondaryButton}" Padding="7,2" FontSize="10" Margin="0,0,4,0"/>
                                        <Button x:Name="BtnCloneCharacter" Content="Nhân bản" Click="BtnCloneCharacter_Click" Style="{StaticResource StudioSecondaryButton}" Padding="7,2" FontSize="10" Margin="0,0,4,0"/>
                                        <Button x:Name="BtnDeleteCharacter" Content="Xóa" Click="BtnDeleteCharacter_Click" Style="{StaticResource StudioSecondaryButton}" Padding="7,2" FontSize="10" Margin="0,0,4,0"/>
                                        <Button x:Name="BtnSaveCharacters" Content="Lưu Nhân Vật" Click="BtnSaveCharacters_Click" Style="{StaticResource StudioPrimaryButton}" Padding="8,2" FontSize="10"/>
                                    </StackPanel>
                                </Grid>

                                <DataGrid x:Name="GridCharacters" Grid.Row="1"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          Background="#0D0F13" Foreground="#F3F4F6"
                                          BorderBrush="#222631" BorderThickness="1"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1B1F2A"
                                          RowBackground="#111319" AlternatingRowBackground="#151821"
                                          HeadersVisibility="Column" RowHeaderWidth="0" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CHAR ID" Binding="{Binding CharacterId}" Width="86"/>
                                        <DataGridTextColumn Header="TÊN NHÂN VẬT" Binding="{Binding Name}" Width="130"/>
                                        <DataGridTextColumn Header="VAI TRÒ" Binding="{Binding Role}" Width="110"/>
                                        <DataGridTextColumn Header="GIỌNG ĐỌC TTS" Binding="{Binding VoiceId}" Width="125"/>
                                        <DataGridTextColumn Header="BADGE" Binding="{Binding AvatarBadge}" Width="62"/>
                                        <DataGridTextColumn Header="MÀU" Binding="{Binding ThemeColor}" Width="68"/>
                                        <DataGridTextColumn Header="MÔ TẢ NGOẠI HÌNH ĐỒNG NHẤT (VISUAL BIBLE)" Binding="{Binding VisualDescription}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- TAB 4: VOICEOVER / BGM / SFX / BEAT-CUT -->
                        <TabItem Header="GIỌNG ĐỌC, ÂM THANH &amp; BEAT" Style="{StaticResource StudioTabItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="7"/>
