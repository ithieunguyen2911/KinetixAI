<Window x:Class="KinetixAI.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kinetix Studio v2.0 — Professional Non-Linear Video Editor (NLE) &amp; Polyglot Automation Workstation"
        Height="920" Width="1560"
        MinHeight="780" MinWidth="1280"
        WindowStartupLocation="CenterScreen"
        Background="#0B0D10"
        Foreground="#F3F4F6"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="BgCanvas" Color="#0B0D10"/>
        <SolidColorBrush x:Key="BgPanel" Color="#12151B"/>
        <SolidColorBrush x:Key="BgSurface" Color="#191D26"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#252A36"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="AccentPrimary" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentHover" Color="#1D4ED8"/>

        <Style x:Key="StudioTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0E1015"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="CaretBrush" Value="#60A5FA"/>
            <Setter Property="BorderBrush" Value="#282E3B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="StudioComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#0E1015"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#282E3B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="StudioPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#1F2430"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2A3040"/>
                                <Setter Property="Foreground" Value="#6B7280"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StudioSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1C202B"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#2D3446"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252B3B"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3E475E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#151821"/>
                                <Setter Property="Foreground" Value="#4B5563"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- TOP NLE WORKSTATION BAR -->
        <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Identity -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="8" Height="18" Background="{StaticResource AccentPrimary}" CornerRadius="2" Margin="0,0,10,0"/>
                    <TextBlock Text="KINETIX STUDIO" FontSize="13.5" FontWeight="Bold" Foreground="#F9FAFB" VerticalAlignment="Center"/>
                    <Border Background="#181C26" BorderBrush="#282E3D" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="NLE v2.0" FontSize="10.5" Foreground="#9CA3AF" FontFamily="Consolas"/>
                    </Border>
                </StackPanel>

                <!-- Quick Format & Speed Bar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="ASPECT:" FontSize="10.5" FontWeight="SemiBold" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button x:Name="BtnAspect16x9" Content="16:9 HD" Click="BtnAspect16x9_Click" Style="{StaticResource StudioSecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,4,0"/>
                    <Button x:Name="BtnAspect9x16" Content="9:16 Shorts" Click="BtnAspect9x16_Click" Style="{StaticResource StudioSecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,4,0"/>
                    <Button x:Name="BtnAspect1x1" Content="1:1 Square" Click="BtnAspect1x1_Click" Style="{StaticResource StudioSecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,16,0"/>

                    <TextBlock Text="SPEED:" FontSize="10.5" FontWeight="SemiBold" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbSpeedFactor" Width="76" SelectedIndex="2" Style="{StaticResource StudioComboBox}" Padding="6,3" FontSize="11" Margin="0,0,6,0">
                        <ComboBoxItem Content="0.50x" Tag="0.5"/>
                        <ComboBoxItem Content="0.75x" Tag="0.75"/>
                        <ComboBoxItem Content="1.00x" Tag="1.0"/>
                        <ComboBoxItem Content="1.25x" Tag="1.25"/>
                        <ComboBoxItem Content="1.50x" Tag="1.5"/>
                        <ComboBoxItem Content="2.00x" Tag="2.0"/>
                    </ComboBox>
                    <Button x:Name="BtnApplySpeed" Content="Apply Speed" Click="BtnApplySpeed_Click" Style="{StaticResource StudioSecondaryButton}" Padding="9,3" FontSize="11"/>
                </StackPanel>

                <!-- Right System Telemetry & MCP Status -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#141821" BorderBrush="#252B3B" BorderThickness="1" CornerRadius="4" Padding="9,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#3B82F6" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtMcpStatus" Text="MCP: kinetix-ai (14 Tools)" FontSize="11" Foreground="#D1D5DB"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#141821" BorderBrush="#252B3B" BorderThickness="1" CornerRadius="4" Padding="9,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotBackend" Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtBackendStatus" Text="Core API: Online" FontSize="11" Foreground="#D1D5DB"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnRefreshProjects" Content="Sync Workspace" Click="BtnRefreshProjects_Click"
                            Style="{StaticResource StudioSecondaryButton}" Padding="10,4" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN 3-COLUMN NLE WORKSPACE -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="355"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT DOCK: PROJECT INGEST, MOTION TEMPLATE & WORKSPACE BIN -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Ingest & Template Configuration -->
                <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14">
                    <StackPanel>
                        <TextBlock Text="MEDIA INGEST &amp; MOTION ENGINE" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="118"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Project Identifier" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtProjectId" Text="studio_master_01" Style="{StaticResource StudioTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Render Engine" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,3"/>
                                <ComboBox x:Name="CmbEngineType" SelectedIndex="0" Style="{StaticResource StudioComboBox}">
                                    <ComboBoxItem Content="remotion" Tag="remotion"/>
                                    <ComboBoxItem Content="hyperframes" Tag="hyperframes"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Motion Graphics Template (Remotion &amp; HyperFrames)" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CmbTemplateId" SelectedIndex="0" Style="{StaticResource StudioComboBox}" Margin="0,0,0,8">
                            <ComboBoxItem Content="CaptionTemplate" Tag="CaptionTemplate"/>
                            <ComboBoxItem Content="KineticTitleCard" Tag="KineticTitleCard"/>
                            <ComboBoxItem Content="SocialPopCaptions" Tag="SocialPopCaptions"/>
                            <ComboBoxItem Content="TechCalloutHUD" Tag="TechCalloutHUD"/>
                        </ComboBox>

                        <TextBlock Text="Source Input (URL, Local File, or demo://sample)" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtSourceUrl" Text="demo://sample" Style="{StaticResource StudioTextBox}"/>
                            <Button x:Name="BtnInspectSource" Grid.Column="2" Content="Inspect" Click="BtnInspectSource_Click"
                                    Style="{StaticResource StudioSecondaryButton}" Padding="8,6" FontSize="11"/>
                            <Button x:Name="BtnBrowseFile" Grid.Column="4" Content="Browse" Click="BtnBrowseFile_Click"
                                    Style="{StaticResource StudioSecondaryButton}" Padding="8,6" FontSize="11"/>
                        </Grid>

                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Script / Captions (blank = Auto-Whisper)" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center"/>
                            <Button x:Name="BtnClearScript" Grid.Column="1" Content="Auto-Whisper (Clear)" Click="BtnClearScript_Click"
                                    Style="{StaticResource StudioSecondaryButton}" Padding="7,2" FontSize="10"/>
                        </Grid>
                        <TextBox x:Name="TxtScriptText"
                                 Text="Kinetix Studio NLE Workstation|Powered by Remotion, HyperFrames &amp; FFmpeg|Clean Architecture + GitHub Spec Kit"
                                 Style="{StaticResource StudioTextBox}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="56" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                        <Button x:Name="BtnRunPipeline" Content="Execute 5-Step Production Pipeline" Click="BtnRunPipeline_Click"
                                Style="{StaticResource StudioPrimaryButton}" Margin="0,0,0,6"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnRerenderSubtitles" Grid.Column="0" Content="Re-Render Overlay" Click="BtnRerenderSubtitles_Click"
                                    Style="{StaticResource StudioSecondaryButton}" Padding="8,6"/>
                            <Button x:Name="BtnOpenFolder" Grid.Column="2" Content="Reveal in Explorer" Click="BtnOpenFolder_Click"
                                    Style="{StaticResource StudioSecondaryButton}" Padding="8,6"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Media Bin / Workspace Projects -->
                <Border Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="MEDIA BIN / WORKSPACE PROJECTS" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF"/>
                            <TextBlock x:Name="TxtProjectCount" Text="0 items" FontSize="10.5" Foreground="#6B7280" HorizontalAlignment="Right"/>
                        </Grid>
                        <ListBox x:Name="LstProjects" Grid.Row="1"
                                 Background="#0D0F13" BorderBrush="#222631" BorderThickness="1"
                                 Foreground="#F3F4F6" SelectionChanged="LstProjects_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,7"/>
                                    <Setter Property="Margin" Value="2"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBd" Background="#12151C" BorderBrush="#1F2430" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="2">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBd" Property="Background" Value="#181C26"/>
                                                        <Setter TargetName="ItemBd" Property="BorderBrush" Value="#2E3648"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBd" Property="Background" Value="#172136"/>
                                                        <Setter TargetName="ItemBd" Property="BorderBrush" Value="#3B82F6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding ProjectId}" FontWeight="SemiBold" FontSize="12" Foreground="#F3F4F6" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding CurrentStep}" FontSize="10.5" Foreground="#9CA3AF" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#1E2433" BorderBrush="#313A50" BorderThickness="1" CornerRadius="3" Padding="6,2" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding EngineUpper}" FontSize="9.5" FontFamily="Consolas" FontWeight="Bold" Foreground="#93C5FD"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- CENTER DOCK: PROGRAM MONITOR + VISUAL MULTI-TRACK NLE TIMELINE + SUBTITLE CUE EDITOR -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="295"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="186"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. PROGRAM VIDEO MONITOR & NLE TRANSPORT DECK -->
                <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="PROGRAM MONITOR" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtOutputPath" Text="" FontSize="10.5" Foreground="#6B7280" FontFamily="Consolas" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtTimecode" Text="00.00s / 06.00s" FontSize="11.5" FontFamily="Consolas" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- 16:9 Dark Studio Video Viewport -->
                        <Border Grid.Row="1" Background="#050608" BorderBrush="#1F2430" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                            <Grid>
                                <TextBlock x:Name="TxtVideoPlaceholder"
                                           Text="No active video loaded in monitor. Select a project or execute pipeline."
                                           Foreground="#6B7280" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <MediaElement x:Name="VideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"
                                              MediaOpened="VideoPlayer_MediaOpened" MediaEnded="VideoPlayer_MediaEnded"/>
                            </Grid>
                        </Border>

                        <!-- NLE Transport & Frame-Accurate Deck -->
                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button x:Name="BtnPlayPause" Content="Play" Width="54" Click="BtnPlayPause_Click" Style="{StaticResource StudioSecondaryButton}" Padding="6,4" Margin="0,0,4,0"/>
                                <Button x:Name="BtnStopVideo" Content="Stop" Width="48" Click="BtnStopVideo_Click" Style="{StaticResource StudioSecondaryButton}" Padding="6,4" Margin="0,0,4,0"/>
                                <Button x:Name="BtnStepBack" Content="-1f" Width="38" ToolTip="Step Backward 1 Frame (1/30s)" Click="BtnStepBack_Click" Style="{StaticResource StudioSecondaryButton}" Padding="4,4" Margin="0,0,4,0"/>
                                <Button x:Name="BtnStepForward" Content="+1f" Width="38" ToolTip="Step Forward 1 Frame (1/30s)" Click="BtnStepForward_Click" Style="{StaticResource StudioSecondaryButton}" Padding="4,4" Margin="0,0,8,0"/>
                                <Button x:Name="BtnMarkIn" Content="Set In [" ToolTip="Set Trim Start to Playhead" Click="BtnMarkIn_Click" Style="{StaticResource StudioSecondaryButton}" Padding="8,4" Margin="0,0,4,0"/>
                                <Button x:Name="BtnMarkOut" Content="Set Out ]" ToolTip="Set Trim End to Playhead" Click="BtnMarkOut_Click" Style="{StaticResource StudioSecondaryButton}" Padding="8,4" Margin="0,0,8,0"/>
                            </StackPanel>

                            <Slider x:Name="SliderScrub" Grid.Column="1" Minimum="0" Maximum="6" Value="0" VerticalAlignment="Center" Margin="6,0,10,0"
                                    PreviewMouseLeftButtonUp="SliderScrub_PreviewMouseLeftButtonUp"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button x:Name="BtnSnapshot" Content="Snapshot PNG" ToolTip="Capture PNG Frame at Playhead" Click="BtnSnapshot_Click" Style="{StaticResource StudioSecondaryButton}" Padding="9,4" Margin="0,0,6,0"/>
                                <Button x:Name="BtnOpenVideo" Content="External Player" Click="BtnOpenVideo_Click" Style="{StaticResource StudioSecondaryButton}" Padding="9,4"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 2. VISUAL MULTI-TRACK NLE TIMELINE (V2 OVERLAY, V1 VIDEO, S1 CAPTIONS, A1 AUDIO) -->
                <Border Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Timeline Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="MULTI-TRACK NLE TIMELINE" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                <TextBlock Text="  •  Click any S1 Caption block or ruler to seek Playhead" FontSize="10.5" Foreground="#6B7280" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtTimelineSummary" Text="4 Tracks Active (V2, V1, S1, A1) | 30.00 fps" FontSize="10.5" FontFamily="Consolas" Foreground="#9CA3AF" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Timecode Ruler -->
                        <Grid Grid.Row="1" Margin="86,0,0,2" Background="#0B0D13" MouseLeftButtonDown="TimelineCanvas_MouseLeftButtonDown" Cursor="Hand">
                            <UniformGrid Rows="1" Columns="6">
                                <TextBlock Text="00:00.0" FontSize="9.5" FontFamily="Consolas" Foreground="#6B7280" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                <TextBlock x:Name="TxtRuler1" Text="00:01.2" FontSize="9.5" FontFamily="Consolas" Foreground="#6B7280" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtRuler2" Text="00:02.4" FontSize="9.5" FontFamily="Consolas" Foreground="#6B7280" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtRuler3" Text="00:03.6" FontSize="9.5" FontFamily="Consolas" Foreground="#6B7280" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtRuler4" Text="00:04.8" FontSize="9.5" FontFamily="Consolas" Foreground="#6B7280" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtRuler5" Text="00:06.0" FontSize="9.5" FontFamily="Consolas" Foreground="#6B7280" VerticalAlignment="Center"/>
                            </UniformGrid>
                        </Grid>

                        <!-- 4 Track Lanes + Playhead Overlay -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Track Headers -->
                            <UniformGrid Grid.Column="0" Rows="4" Columns="1" Margin="0,0,4,0">
                                <Border Background="#141822" BorderBrush="#23293A" BorderThickness="1" CornerRadius="3" Margin="0,1" Padding="6,0">
                                    <TextBlock Text="V2 OVERLAY" FontSize="9.5" FontFamily="Consolas" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="#141822" BorderBrush="#23293A" BorderThickness="1" CornerRadius="3" Margin="0,1" Padding="6,0">
                                    <TextBlock Text="V1 VIDEO" FontSize="9.5" FontFamily="Consolas" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="#141822" BorderBrush="#23293A" BorderThickness="1" CornerRadius="3" Margin="0,1" Padding="6,0">
                                    <TextBlock Text="S1 CAPTIONS" FontSize="9.5" FontFamily="Consolas" FontWeight="Bold" Foreground="#FBBF24" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="#141822" BorderBrush="#23293A" BorderThickness="1" CornerRadius="3" Margin="0,1" Padding="6,0">
                                    <TextBlock Text="A1 AUDIO" FontSize="9.5" FontFamily="Consolas" FontWeight="Bold" Foreground="#A78BFA" VerticalAlignment="Center"/>
                                </Border>
                            </UniformGrid>

                            <!-- Track Content Lanes -->
                            <Grid x:Name="TimelineTrackArea" Grid.Column="1" Background="#090B10" ClipToBounds="True"
                                  SizeChanged="TimelineTrackArea_SizeChanged"
                                  MouseLeftButtonDown="TimelineCanvas_MouseLeftButtonDown" Cursor="Hand">
                                <UniformGrid Rows="4" Columns="1">
                                    <!-- V2 Motion Overlay Track -->
                                    <Border BorderBrush="#171B26" BorderThickness="0,0,0,1" Padding="2">
                                        <Border Background="#172554" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="3" Padding="8,0">
                                            <TextBlock x:Name="TxtTrackV2" Text="REMOTION / HYPERFRAMES OVERLAY COMPOSITION (CaptionTemplate)" FontSize="10" FontFamily="Consolas" Foreground="#BFDBFE" VerticalAlignment="Center"/>
                                        </Border>
                                    </Border>

                                    <!-- V1 Main Video Track -->
                                    <Border BorderBrush="#171B26" BorderThickness="0,0,0,1" Padding="2">
                                        <Border Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="3" Padding="8,0">
                                            <TextBlock x:Name="TxtTrackV1" Text="MASTER VIDEO STREAM (h264 • 1280x720 • 30.00 fps)" FontSize="10" FontFamily="Consolas" Foreground="#A7F3D0" VerticalAlignment="Center"/>
                                        </Border>
                                    </Border>

                                    <!-- S1 Whisper Subtitle Cues Track (Dynamic Proportional Blocks) -->
                                    <Border BorderBrush="#171B26" BorderThickness="0,0,0,1" Padding="0,2">
                                        <ItemsControl x:Name="IcTimelineSubtitles">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Height="24"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding LeftPx}"/>
                                                    <Setter Property="Canvas.Top" Value="0"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding WidthPx}" Height="23"
                                                            Background="#422006" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="3"
                                                            Padding="5,0" Cursor="Hand"
                                                            MouseLeftButtonDown="SubtitleTimelineBlock_MouseLeftButtonDown"
                                                            ToolTip="{Binding Label}">
                                                        <TextBlock Text="{Binding Label}" FontSize="9.5" Foreground="#FEF3C7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                    <!-- A1 Audio Stream & Waveform Track -->
                                    <Border Padding="2">
                                        <Border Background="#2E1065" BorderBrush="#8B5CF6" BorderThickness="1" CornerRadius="3" Padding="8,0">
                                            <TextBlock x:Name="TxtTrackA1" Text="AUDIO STREAM  ▂▄▆█▄▂▅▇▃▂▆█▄▂▅▇▃▂▆█▄▂  (AAC / 16000Hz Speech Bandpass)" FontSize="10" FontFamily="Consolas" Foreground="#DDD6FE" VerticalAlignment="Center"/>
                                        </Border>
                                    </Border>
                                </UniformGrid>

                                <!-- Red Playhead Vertical Line -->
                                <Canvas IsHitTestVisible="False">
                                    <Border x:Name="PlayheadLine" Canvas.Left="0" Canvas.Top="0" Width="2" Height="140" Background="#EF4444">
                                        <Border Width="10" Height="8" Background="#EF4444" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="-4,0,0,0"/>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 3. SUBTITLE CUE EDITOR TABLE -->
                <Border Grid.Row="4" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="SUBTITLE CUE EDITOR (WHISPER WORD-LEVEL TIMESTAMPS)" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnAddSubtitleRow" Content="+ Add Cue" Click="BtnAddSubtitleRow_Click"
                                        Style="{StaticResource StudioSecondaryButton}" Padding="9,3" FontSize="11" Margin="0,0,6,0"/>
                                <Button x:Name="BtnSplitSubtitleCue" Content="Split Cue at Playhead" Click="BtnSplitSubtitleCue_Click"
                                        Style="{StaticResource StudioSecondaryButton}" Padding="9,3" FontSize="11" Margin="0,0,6,0"/>
                                <Button x:Name="BtnExportSubtitles" Content="Export SRT / VTT" Click="BtnExportSubtitles_Click"
                                        Style="{StaticResource StudioSecondaryButton}" Padding="9,3" FontSize="11" Margin="0,0,6,0"/>
                                <Button x:Name="BtnRemoveSubtitleRow" Content="Remove Cue" Click="BtnRemoveSubtitleRow_Click"
                                        Style="{StaticResource StudioSecondaryButton}" Padding="9,3" FontSize="11"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid x:Name="GridSubtitles" Grid.Row="1"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  Background="#0D0F13" Foreground="#F3F4F6"
                                  BorderBrush="#222631" BorderThickness="1"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1B1F2A"
                                  RowBackground="#111319" AlternatingRowBackground="#151821"
                                  HeadersVisibility="Column" RowHeaderWidth="0" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="IN (SEC)" Binding="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}" Width="82"/>
                                <DataGridTextColumn Header="OUT (SEC)" Binding="{Binding EndTime, UpdateSourceTrigger=PropertyChanged}" Width="82"/>
                                <DataGridTextColumn Header="DUR" Binding="{Binding DurationDisplay}" Width="66" IsReadOnly="True"/>
                                <DataGridTextColumn Header="WORDS" Binding="{Binding WordCount}" Width="62" IsReadOnly="True"/>
                                <DataGridTextColumn Header="CAPTION DIALOGUE TEXT (EDITABLE)" Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT DOCK: INSPECTOR, COLOR GRADING, TRIM/AUDIO MASTERING & TELEMETRY -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. Stream Inspector & Pipeline Status -->
                <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="PIPELINE &amp; FFPROBE STREAM INSPECTOR" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF"/>
                            <TextBlock x:Name="TxtProgressPercent" Text="100%" FontSize="11" FontFamily="Consolas" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar x:Name="PbPipeline" Height="5" Minimum="0" Maximum="100" Value="100"
                                     Background="#181C26" Foreground="{StaticResource AccentPrimary}" BorderThickness="0" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtStepStatus" Text="Ready" FontSize="11" Foreground="#D1D5DB" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>

                        <Border Background="#0D0F14" BorderBrush="#202532" BorderThickness="1" CornerRadius="4" Padding="10,7">
                            <UniformGrid Rows="3" Columns="2">
                                <TextBlock x:Name="TxtSpecResolution" Text="RES: 1280x720" FontSize="10.5" FontFamily="Consolas" Foreground="#D1D5DB" Margin="0,1"/>
                                <TextBlock x:Name="TxtSpecFps" Text="FPS: 30.00" FontSize="10.5" FontFamily="Consolas" Foreground="#D1D5DB" Margin="0,1"/>
                                <TextBlock x:Name="TxtSpecCodec" Text="VID: h264" FontSize="10.5" FontFamily="Consolas" Foreground="#D1D5DB" Margin="0,1"/>
                                <TextBlock x:Name="TxtSpecAudio" Text="AUD: aac / 16000Hz" FontSize="10.5" FontFamily="Consolas" Foreground="#D1D5DB" Margin="0,1"/>
                                <TextBlock x:Name="TxtSpecDuration" Text="DUR: 6.00s" FontSize="10.5" FontFamily="Consolas" Foreground="#D1D5DB" Margin="0,1"/>
                                <TextBlock x:Name="TxtSpecSize" Text="SIZE: -- KB" FontSize="10.5" FontFamily="Consolas" Foreground="#D1D5DB" Margin="0,1"/>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 2. Color Grading & LUT Studio -->
                <Border Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="COLOR GRADING &amp; LUT STUDIO (FFMPEG EQ)" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                            <Button x:Name="BtnResetColor" Content="Reset" Click="BtnResetColor_Click" Style="{StaticResource StudioSecondaryButton}" Padding="7,2" FontSize="10" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Look Preset:" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbColorPreset" Grid.Column="2" SelectedIndex="0" Style="{StaticResource StudioComboBox}" Padding="8,4">
                                <ComboBoxItem Content="natural (Rec.709 Standard)" Tag="natural"/>
                                <ComboBoxItem Content="teal_orange (Cinematic Grade)" Tag="teal_orange"/>
                                <ComboBoxItem Content="warm_vintage (Golden Film)" Tag="warm_vintage"/>
                                <ComboBoxItem Content="noir_bw (High-Contrast B&amp;W)" Tag="noir_bw"/>
                                <ComboBoxItem Content="studio_crisp (Broadcast Sharp)" Tag="studio_crisp"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Brightness" FontSize="10.5" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                            <Slider x:Name="SliderBrightness" Grid.Column="1" Minimum="-0.4" Maximum="0.4" Value="0.0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ElementName=SliderBrightness, Path=Value, StringFormat={}{0:0.00}}" Grid.Column="2" FontSize="10" FontFamily="Consolas" Foreground="#D1D5DB" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Contrast" FontSize="10.5" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                            <Slider x:Name="SliderContrast" Grid.Column="1" Minimum="0.5" Maximum="2.0" Value="1.0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ElementName=SliderContrast, Path=Value, StringFormat={}{0:0.00}}" Grid.Column="2" FontSize="10" FontFamily="Consolas" Foreground="#D1D5DB" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Saturation" FontSize="10.5" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                            <Slider x:Name="SliderSaturation" Grid.Column="1" Minimum="0.0" Maximum="2.5" Value="1.0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ElementName=SliderSaturation, Path=Value, StringFormat={}{0:0.00}}" Grid.Column="2" FontSize="10" FontFamily="Consolas" Foreground="#D1D5DB" HorizontalAlignment="Right"/>
                        </Grid>

                        <Button x:Name="BtnApplyColorGrade" Content="Apply Color Grade to Master" Click="BtnApplyColorGrade_Click"
                                Style="{StaticResource StudioSecondaryButton}" Padding="10,5"/>
                    </StackPanel>
                </Border>

                <!-- 3. Non-Linear Trim & Audio Mastering Studio -->
                <Border Grid.Row="4" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="NON-LINEAR TRIM &amp; AUDIO MASTERING" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,6"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtTrimStart" Grid.Column="0" Text="0.0" Style="{StaticResource StudioTextBox}" ToolTip="Trim In (Seconds)"/>
                            <TextBox x:Name="TxtTrimEnd" Grid.Column="2" Text="6.0" Style="{StaticResource StudioTextBox}" ToolTip="Trim Out (Seconds)"/>
                            <Button x:Name="BtnTrimVideo" Grid.Column="4" Content="Trim MP4" Click="BtnTrimVideo_Click"
                                    Style="{StaticResource StudioSecondaryButton}" Padding="10,5"/>
                        </Grid>

                        <UniformGrid Rows="1" Columns="3" Margin="0,0,0,8">
                            <CheckBox x:Name="ChkSilenceCut" Content="Silence Cut" Foreground="#D1D5DB" FontSize="11" VerticalContentAlignment="Center"/>
                            <CheckBox x:Name="ChkLoudnorm" Content="EBU R128" IsChecked="True" Foreground="#D1D5DB" FontSize="11" VerticalContentAlignment="Center"/>
                            <CheckBox x:Name="ChkMixBgm" Content="+ Mix BGM" IsChecked="True" Foreground="#D1D5DB" FontSize="11" VerticalContentAlignment="Center"/>
                        </UniformGrid>

                        <Button x:Name="BtnMasterAudio" Content="Execute Audio Mastering &amp; BGM Mix" Click="BtnMasterAudio_Click"
                                Style="{StaticResource StudioSecondaryButton}" Padding="10,5"/>
                    </StackPanel>
                </Border>

                <!-- 4. AI Antigravity MCP Dispatch & Telemetry Log -->
                <Border Grid.Row="6" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="ANTIGRAVITY MCP DIRECT COMMAND &amp; LOG" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,6"/>
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtAiCommand" Grid.Column="0" Text="Render HyperFrames promo video" Style="{StaticResource StudioTextBox}"/>
                            <Button x:Name="BtnRunAiCommand" Grid.Column="2" Content="Dispatch" Click="BtnRunAiCommand_Click"
                                    Style="{StaticResource StudioSecondaryButton}" Padding="10,5"/>
                        </Grid>
                        <TextBox x:Name="TxtLogs" Grid.Row="2"
                                 Background="#090A0E" Foreground="#9CA3AF" BorderBrush="#1C202B" BorderThickness="1"
                                 FontFamily="Consolas" FontSize="10.5" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap" Padding="6"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="#0D0F14" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid>
                <TextBlock Text="Clean Architecture: Domain -> Application -> Infrastructure -> Presentation | Spec Kit (.specify/memory/constitution.md) | 5 GitHub Adapters Active"
                           FontSize="10.5" Foreground="#6B7280" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtStatusRight" Text="Workstation Ready" FontSize="10.5" Foreground="#9CA3AF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
