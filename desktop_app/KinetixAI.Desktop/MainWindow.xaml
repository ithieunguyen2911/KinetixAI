<Window x:Class="KinetixAI.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kinetix Studio — Polyglot Video Automation &amp; Compositing Workstation"
        Height="880" Width="1400"
        MinHeight="760" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgApp}"
        Foreground="{StaticResource TextPrimary}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- TOP WORKSTATION HEADER BAR -->
        <Border Grid.Row="0" Background="#0D0F14" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Identity -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="10" Height="18" Background="#2563EB" CornerRadius="2" Margin="0,0,10,0"/>
                    <TextBlock Text="KINETIX STUDIO" FontSize="13.5" FontWeight="Bold" Foreground="#F9FAFB" VerticalAlignment="Center"/>
                    <TextBlock Text="v1.2" FontSize="11" Foreground="#6B7280" Margin="8,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 5-Stage Pipeline Architecture Stepper -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#151821" BorderBrush="#242936" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                        <TextBlock Text="01 INGEST · yt-dlp" FontSize="11" Foreground="#9CA3AF" FontFamily="Consolas"/>
                    </Border>
                    <Border Background="#151821" BorderBrush="#242936" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                        <TextBlock Text="02 AUDIO · FFmpeg 16kHz" FontSize="11" Foreground="#9CA3AF" FontFamily="Consolas"/>
                    </Border>
                    <Border Background="#151821" BorderBrush="#242936" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                        <TextBlock Text="03 ASR · Whisper" FontSize="11" Foreground="#9CA3AF" FontFamily="Consolas"/>
                    </Border>
                    <Border Background="#151821" BorderBrush="#242936" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                        <TextBlock Text="04 MOTION · Remotion / HyperFrames" FontSize="11" Foreground="#9CA3AF" FontFamily="Consolas"/>
                    </Border>
                    <Border Background="#151821" BorderBrush="#242936" BorderThickness="1" CornerRadius="4" Padding="8,3">
                        <TextBlock Text="05 MASTER · H.264 MP4" FontSize="11" Foreground="#9CA3AF" FontFamily="Consolas"/>
                    </Border>
                </StackPanel>

                <!-- System Telemetry Indicators -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#13161F" BorderBrush="#222631" BorderThickness="1" CornerRadius="4" Padding="9,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#3B82F6" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtMcpStatus" Text="MCP: kinetix-ai" FontSize="11" Foreground="#D1D5DB" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#13161F" BorderBrush="#222631" BorderThickness="1" CornerRadius="4" Padding="9,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotBackend" Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtBackendStatus" Text="Core API: 127.0.0.1:8000" FontSize="11" Foreground="#D1D5DB" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnRefreshProjects" Content="Sync Workspace" Click="BtnRefreshProjects_Click"
                            Style="{StaticResource StudioSecondaryButton}" Padding="10,4" FontSize="11.5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN 3-PANE WORKSPACE -->
        <Grid Grid.Row="1" Margin="14,12,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANE: PROJECT CONFIGURATION & EXPLORER -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Configuration Card -->
                <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="PIPELINE PARAMETERS" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Project Identifier" Foreground="#9CA3AF" FontSize="11.5" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtProjectId" Text="studio_master_01" Style="{StaticResource StudioTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Render Engine" Foreground="#9CA3AF" FontSize="11.5" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbEngineType" SelectedIndex="0" Style="{StaticResource StudioComboBox}">
                                    <ComboBoxItem Content="remotion" Tag="remotion"/>
                                    <ComboBoxItem Content="hyperframes" Tag="hyperframes"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Source Input (YouTube/Video URL, Local File, or demo://sample)" Foreground="#9CA3AF" FontSize="11.5" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtSourceUrl" Text="demo://sample" Style="{StaticResource StudioTextBox}"/>
                            <Button x:Name="BtnInspectSource" Grid.Column="2" Content="Inspect" Click="BtnInspectSource_Click"
                                    Style="{StaticResource StudioSecondaryButton}" Padding="10,7"/>
                            <Button x:Name="BtnBrowseFile" Grid.Column="4" Content="Browse" Click="BtnBrowseFile_Click"
                                    Style="{StaticResource StudioSecondaryButton}" Padding="10,7"/>
                        </Grid>

                        <TextBlock Text="Composition Template ID" Foreground="#9CA3AF" FontSize="11.5" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtTemplateId" Text="CaptionTemplate" Style="{StaticResource StudioTextBox}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Script / Captions (blank = Auto-Whisper STT)" Foreground="#9CA3AF" FontSize="11.5" VerticalAlignment="Center"/>
                            <Button x:Name="BtnClearScript" Grid.Column="1" Content="Auto-Whisper (Clear)" Click="BtnClearScript_Click"
                                    Style="{StaticResource StudioSecondaryButton}" Padding="8,2" FontSize="10.5"/>
                        </Grid>
                        <TextBox x:Name="TxtScriptText"
                                 Text="Kinetix Studio Automated Video Pipeline|Powered by Remotion, HyperFrames &amp; FFmpeg|Spec-Driven Development with GitHub Spec Kit"
                                 Style="{StaticResource StudioTextBox}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="64" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

                        <Button x:Name="BtnRunPipeline" Content="Execute 5-Step Production Pipeline" Click="BtnRunPipeline_Click"
                                Style="{StaticResource StudioPrimaryButton}" Margin="0,0,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnRerenderSubtitles" Grid.Column="0" Content="Re-Render Overlay" Click="BtnRerenderSubtitles_Click"
                                    Style="{StaticResource StudioSecondaryButton}"/>
                            <Button x:Name="BtnOpenFolder" Grid.Column="2" Content="Reveal in Explorer" Click="BtnOpenFolder_Click"
                                    Style="{StaticResource StudioSecondaryButton}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Workspace Project Explorer -->
                <Border Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="16,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="WORKSPACE PROJECTS" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                            <TextBlock x:Name="TxtProjectCount" Text="0 items" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Right"/>
                        </Grid>
                        <ListBox x:Name="LstProjects" Grid.Row="1"
                                 Background="#0D0F13" BorderBrush="#222631" BorderThickness="1"
                                 Foreground="#F3F4F6" SelectionChanged="LstProjects_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="Margin" Value="2"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBd" Background="#12151C" BorderBrush="#1F2430" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="2">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBd" Property="Background" Value="#191D27"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBd" Property="Background" Value="#1E293B"/>
                                                        <Setter TargetName="ItemBd" Property="BorderBrush" Value="#3B82F6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding ProjectId}" FontWeight="SemiBold" FontSize="12.5" Foreground="#F3F4F6" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding CurrentStep}" FontSize="11" Foreground="#6B7280" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#181C26" BorderBrush="#2C3242" BorderThickness="1" CornerRadius="3" Padding="6,2" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding EngineUpper}" FontSize="10" FontWeight="SemiBold" Foreground="#93C5FD" FontFamily="Consolas"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT PANE: VIDEO MONITOR + TECHNICAL INSPECTOR + SUBTITLE TIMELINE + TELEMETRY -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="330"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="135"/>
                </Grid.RowDefinitions>

                <!-- TOP RIGHT: VIDEO PROGRAM MONITOR + MEDIA STREAM INSPECTOR -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.55*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Program Video Monitor (Built-in MediaElement Player) -->
                    <Border Grid.Column="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Monitor Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="PROGRAM MONITOR" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtTimecode" Text="00:00.00 / 00:06.00" FontSize="11.5" FontFamily="Consolas" Foreground="#D1D5DB" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 16:9 Video Viewport -->
                            <Border Grid.Row="1" Background="#050608" BorderBrush="#1D202A" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                                <Grid>
                                    <MediaElement x:Name="VideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"
                                                  MediaOpened="VideoPlayer_MediaOpened" MediaEnded="VideoPlayer_MediaEnded"/>
                                    <TextBlock x:Name="TxtVideoPlaceholder"
                                               Text="Select or run a project to load rendered MP4 stream"
                                               Foreground="#4B5563" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                </Grid>
                            </Border>

                            <!-- Transport Bar -->
                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnPlayPause" Grid.Column="0" Content="Play" Click="BtnPlayPause_Click"
                                        Style="{StaticResource StudioSecondaryButton}" Width="64" Padding="8,4" Margin="0,0,6,0"/>
                                <Button x:Name="BtnStopVideo" Grid.Column="1" Content="Stop" Click="BtnStopVideo_Click"
                                        Style="{StaticResource StudioSecondaryButton}" Width="56" Padding="8,4" Margin="0,0,10,0"/>
                                <Slider x:Name="SliderScrub" Grid.Column="2" Minimum="0" Maximum="6" Value="0" VerticalAlignment="Center"
                                        PreviewMouseLeftButtonUp="SliderScrub_PreviewMouseLeftButtonUp"/>
                                <Button x:Name="BtnOpenVideo" Grid.Column="3" Content="External Player" Click="BtnOpenVideo_Click"
                                        Style="{StaticResource StudioSecondaryButton}" Padding="10,4" Margin="10,0,0,0"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Technical Stream Inspector (ffprobe + Trim + MCP Dispatch) -->
                    <Border Grid.Column="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Active Pipeline Status -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="PIPELINE STATUS" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                                    <TextBlock x:Name="TxtProgressPercent" Text="100%" FontSize="11.5" FontFamily="Consolas" Foreground="#60A5FA" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="PbPipeline" Minimum="0" Maximum="100" Value="0" Height="6"
                                             Background="#1B1F29" Foreground="#2563EB" BorderThickness="0" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtStepStatus" Text="Ready" FontSize="11.5" Foreground="#D1D5DB" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- FFprobe Stream Metadata Grid -->
                            <Border Grid.Row="1" Background="#0D0F13" BorderBrush="#222631" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="FFPROBE STREAM METADATA" FontSize="10.5" FontWeight="Bold" Foreground="#6B7280" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="20"/>
                                            <RowDefinition Height="20"/>
                                            <RowDefinition Height="20"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" x:Name="TxtSpecResolution" Text="RES: 1280x720" FontSize="11" FontFamily="Consolas" Foreground="#D1D5DB"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtSpecFps" Text="FPS: 30.00" FontSize="11" FontFamily="Consolas" Foreground="#D1D5DB"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" x:Name="TxtSpecCodec" Text="VID: h264 (yuv420p)" FontSize="11" FontFamily="Consolas" Foreground="#D1D5DB"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtSpecAudio" Text="AUD: aac / 16kHz" FontSize="11" FontFamily="Consolas" Foreground="#D1D5DB"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" x:Name="TxtSpecDuration" Text="DUR: 6.00s" FontSize="11" FontFamily="Consolas" Foreground="#D1D5DB"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtSpecSize" Text="SIZE: -- KB" FontSize="11" FontFamily="Consolas" Foreground="#D1D5DB"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Non-Linear FFmpeg Trim Tool -->
                            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                                <TextBlock Text="FFMPEG STREAM TRIM (SECONDS)" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtTrimStart" Grid.Column="0" Text="0.0" Style="{StaticResource StudioTextBox}" Padding="7,4"/>
                                    <TextBox x:Name="TxtTrimEnd" Grid.Column="2" Text="4.0" Style="{StaticResource StudioTextBox}" Padding="7,4"/>
                                    <Button x:Name="BtnTrimVideo" Grid.Column="4" Content="Trim MP4" Click="BtnTrimVideo_Click"
                                            Style="{StaticResource StudioSecondaryButton}" Padding="10,4"/>
                                </Grid>
                            </StackPanel>

                            <!-- Antigravity MCP Quick Dispatch -->
                            <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                                <TextBlock Text="ANTIGRAVITY MCP DIRECT COMMAND" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtAiCommand" Grid.Column="0"
                                             Text="Render HyperFrames promo video"
                                             Style="{StaticResource StudioTextBox}" Padding="8,5"/>
                                    <Button x:Name="BtnRunAiCommand" Grid.Column="2" Content="Dispatch" Click="BtnRunAiCommand_Click"
                                            Style="{StaticResource StudioPrimaryButton}" Padding="12,5"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- MIDDLE RIGHT: WHISPER SUBTITLE TIMELINE EDITOR -->
                <Border Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="SUBTITLE TIMELINE TRACK (WHISPER WORD-LEVEL TIMESTAMPS)" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF"/>
                                <TextBlock x:Name="TxtOutputPath" Text="" FontSize="11" Foreground="#6B7280" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="480"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="BtnAddSubtitleRow" Content="+ Add Cue" Click="BtnAddSubtitleRow_Click"
                                        Style="{StaticResource StudioSecondaryButton}" Padding="9,3" FontSize="11" Margin="0,0,6,0"/>
                                <Button x:Name="BtnRemoveSubtitleRow" Content="- Remove Cue" Click="BtnRemoveSubtitleRow_Click"
                                        Style="{StaticResource StudioSecondaryButton}" Padding="9,3" FontSize="11"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid x:Name="GridSubtitles" Grid.Row="1" Style="{StaticResource StudioDataGrid}"
                                  AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="IN (SEC)" Binding="{Binding StartTime, StringFormat={}{0:0.000}}" Width="95"/>
                                <DataGridTextColumn Header="OUT (SEC)" Binding="{Binding EndTime, StringFormat={}{0:0.000}}" Width="95"/>
                                <DataGridTextColumn Header="DURATION" Binding="{Binding DurationDisplay}" Width="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="WORDS" Binding="{Binding WordCount}" Width="75" IsReadOnly="True"/>
                                <DataGridTextColumn Header="CAPTION DIALOGUE TEXT (EDITABLE)" Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- BOTTOM RIGHT: MONOSPACE SYSTEM CONSOLE -->
                <Border Grid.Row="4" Background="#0B0D12" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <TextBlock Text="SYSTEM &amp; MCP TELEMETRY LOG" FontSize="10.5" FontWeight="Bold" Foreground="#6B7280"/>
                            <TextBlock Text="Clean Architecture · SOLID · GitHub Spec Kit" FontSize="10.5" Foreground="#4B5563" HorizontalAlignment="Right" FontFamily="Consolas"/>
                        </Grid>
                        <TextBox x:Name="TxtLogs" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Background="Transparent" Foreground="#9CA3AF" BorderThickness="0" FontFamily="Consolas" FontSize="11.5"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="#0D0F14" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="18,0">
            <Grid>
                <TextBlock Text="Architecture: Domain -> Application -> Infrastructure -> Presentation  |  Spec Kit: .specify/memory/constitution.md v1.0.0"
                           Foreground="#6B7280" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtStatusRight" Text="Ready" Foreground="#9CA3AF" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
