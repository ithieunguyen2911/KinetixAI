                                            <ComboBox x:Name="CmbPodcastHostVoice" Grid.Column="2" SelectedIndex="0" Style="{StaticResource StudioComboBox}" Padding="4,3" FontSize="10">
                                                <ComboBoxItem Content="Host: Hoai My" Tag="vi-VN-HoaiMyNeural"/>
                                                <ComboBoxItem Content="Host: Nam Minh" Tag="vi-VN-NamMinhNeural"/>
                                                <ComboBoxItem Content="Host: Aria (EN)" Tag="en-US-AriaNeural"/>
                                                <ComboBoxItem Content="Host: Offline SAPI" Tag="win-sapi-studio"/>
