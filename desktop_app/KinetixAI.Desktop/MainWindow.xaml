                <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="11,7">
                    <StackPanel>
                        <Grid Margin="0,0,0,3">
                            <TextBlock Text="PIPELINE &amp; FFPROBE INSPECTOR" FontSize="9.5" FontWeight="Bold" Foreground="#9CA3AF"/>
                            <TextBlock x:Name="TxtProgressPercent" Text="100%" FontSize="10" FontFamily="Consolas" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar x:Name="PbPipeline" Height="5" Minimum="0" Maximum="100" Value="100"
                                     Background="#181C26" Foreground="{StaticResource AccentPrimary}" BorderThickness="0" Margin="0,0,0,3"/>
                        <TextBlock x:Name="TxtStepStatus" Text="Ready" FontSize="10" Foreground="#D1D5DB" Margin="0,0,0,5" TextTrimming="CharacterEllipsis"/>

                        <Border Background="#0D0F14" BorderBrush="#202532" BorderThickness="1" CornerRadius="4" Padding="7,4">
                            <UniformGrid Rows="3" Columns="2">
                                <TextBlock x:Name="TxtSpecResolution" Text="RES: 1280x720" FontSize="9.5" FontFamily="Consolas" Foreground="#D1D5DB" Margin="0,1"/>
