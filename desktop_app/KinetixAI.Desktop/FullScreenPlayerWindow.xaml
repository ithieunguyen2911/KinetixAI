<Window x:Class="KinetixAI.Desktop.FullScreenPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kinetix Studio — Rạp Chiếu Phim Toàn Màn Hình"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        Background="#000000"
        WindowStartupLocation="CenterScreen"
        Focusable="True"
        KeyDown="Window_KeyDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <SolidColorBrush x:Key="GlassBg" Color="#D9080B12"/>
        <SolidColorBrush x:Key="GlassBorder" Color="#334155"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#38BDF8"/>
        <SolidColorBrush x:Key="TextLight" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>

        <Style x:Key="CinemaButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#000000">
        <!-- 1. MAIN CINEMA VIDEO CANVAS (1:1 UNIFORM ASPECT RATIO) -->
        <MediaElement x:Name="FsPlayer"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      Stretch="Uniform"
                      MediaOpened="FsPlayer_MediaOpened"
                      MediaEnded="FsPlayer_MediaEnded"/>

        <!-- 2. AUTO-HIDING GLASS HUD OVERLAY CONTAINER -->
        <Grid x:Name="HudContainer" Opacity="1.0">
            <!-- TOP CINEMA BANNER -->
            <Border VerticalAlignment="Top"
                    Background="{StaticResource GlassBg}"
                    BorderBrush="{StaticResource GlassBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="24,14"
                    Margin="0,0,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#0284C7" CornerRadius="4" Padding="7,3" Margin="0,0,12,0">
                            <TextBlock Text="CINEMA 1:1" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                        <TextBlock x:Name="TxtFsTitle"
                                   Text="TẬP 1: TUỔI 30 VÀ KHOẢN NỢ CỦA GIẤC MƠ ĐỔI ĐỜI"
                                   FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextLight}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtFsSpecs"
                                   Text="•  1280x720  •  30 fps  •  AAC 24kHz"
                                   FontSize="12" Foreground="{StaticResource TextMuted}"
                                   Margin="14,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Phím tắt: [Space] Phát/Dừng  •  [←/→] ±5s  •  [M] Tắt tiếng  •  [Esc/F11] Thoát"
                                   FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <Button x:Name="BtnTopClose" Content="Thu Nhỏ [Esc] ✕"
                                Click="BtnFsExit_Click" Style="{StaticResource CinemaButton}"
                                Padding="12,5" Background="#0F172A" BorderBrush="#334155"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- BOTTOM FLOATING TRANSPORT CONTROL DOCK -->
            <Border VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Background="{StaticResource GlassBg}"
                    BorderBrush="{StaticResource GlassBorder}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="22,14"
                    Margin="0,0,0,32"
                    MinWidth="920"
                    MaxWidth="1380">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Full-Width Scrubber Slider & Progress Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Slider x:Name="FsSliderScrub"
                                Minimum="0" Maximum="100" Value="0"
                                VerticalAlignment="Center"
                                PreviewMouseLeftButtonUp="FsSliderScrub_PreviewMouseLeftButtonUp"
                                Cursor="Hand"/>
                    </Grid>

                    <!-- Row 1: Transport Controls, Timecode & Volume Deck -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Deck: Play/Pause, Step ±5s, Stop -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnFsPlayPause" Content="Play ⏵" Width="82"
                                    Click="BtnFsPlayPause_Click" Style="{StaticResource CinemaButton}"
                                    Background="#2563EB" BorderBrush="#60A5FA" Margin="0,0,6,0"/>
                            <Button x:Name="BtnFsReplay5s" Content="⏪ -5s" Width="60"
                                    Click="BtnFsReplay5s_Click" Style="{StaticResource CinemaButton}"
                                    Margin="0,0,4,0" ToolTip="Lùi lại 5 giây [Phím mũi tên trái]"/>
                            <Button x:Name="BtnFsForward5s" Content="+5s ⏩" Width="60"
                                    Click="BtnFsForward5s_Click" Style="{StaticResource CinemaButton}"
                                    Margin="0,0,6,0" ToolTip="Tiến tới 5 giây [Phím mũi tên phải]"/>
                            <Button x:Name="BtnFsStop" Content="⏹ Stop" Width="66"
                                    Click="BtnFsStop_Click" Style="{StaticResource CinemaButton}"
                                    Margin="0,0,14,0"/>

                            <TextBlock x:Name="TxtFsTimecode"
                                       Text="00:00.00 / 00:00.00"
                                       FontSize="13.5" FontFamily="Consolas" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBlue}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Center Deck: Empty spacer for aesthetic breathing room -->
                        <Grid Grid.Column="1"/>

                        <!-- Right Deck: Volume Slider, Mute & Exit Button -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnFsMute" Content="🔊" Width="36"
                                    Click="BtnFsMute_Click" Style="{StaticResource CinemaButton}"
                                    Margin="0,0,8,0" ToolTip="Bật / Tắt âm thanh [M]"/>
                            <Slider x:Name="FsVolumeSlider" Width="100"
                                    Minimum="0" Maximum="1" Value="1.0"
                                    VerticalAlignment="Center" Margin="0,0,18,0"
                                    ValueChanged="FsVolumeSlider_ValueChanged"
                                    ToolTip="Âm lượng"/>
                            <Button x:Name="BtnFsExit" Content="⛶ Thu Nhỏ [Esc]"
                                    Click="BtnFsExit_Click" Style="{StaticResource CinemaButton}"
                                    Background="#334155" Padding="14,6"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
